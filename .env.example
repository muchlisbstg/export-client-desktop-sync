# Embedded desktop API defaults
API_PORT=4002
# Keep loopback unless you explicitly need LAN access.
API_HOST=127.0.0.1

# Optional demo-only peer sync. Leave the secret blank to disable sync.
SYNC_NODE_ID=desktop-local
SYNC_SHARED_SECRET=
# Example local peers; use HTTPS for any non-loopback network.
SYNC_PEERS=web-local=http://127.0.0.1:4000,mobile-local=http://127.0.0.1:4001

# Never put real client data here. Sync transfers inquiry contact data.
